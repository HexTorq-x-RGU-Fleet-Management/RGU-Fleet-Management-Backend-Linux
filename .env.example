# Node loads .env for npm start/test. Never commit the real .env.
PORT=8102
HOST=127.0.0.1
FRONTEND_ORIGINS=http://127.0.0.1:3107,http://localhost:3107
COOKIE_SAME_SITE=Strict
# PUBLIC_ORIGIN=https://api.example.com
# Cross-site HTTPS deployments may require COOKIE_SAME_SITE=None plus Secure cookies.
# Compose overrides these file paths inside its container. For direct Linux startup,
# use absolute private paths owned by the service user, mode 600 or 400.
DATABASE_URL_FILE=/run/secrets/database-url
HIK_SAAS_MASTER_KEY_FILE=/run/secrets/provider-key
GOOGLE_CLIENT_ID=
# Database URL file content: postgresql://cam_app:URL_ENCODED_PASSWORD@DB_HOST:5432/rgu_fleet
# DB_HOST inside Docker is not the host loopback. Use a reachable private address.
# Direct Linux example: HIK_SAAS_DATA_DIR=/home/mohan/cam/rgu-data
# Never generate a new key over migrated provider ciphertext.
# HIK_PYTHON=/app/runtime/wine-python.sh
# SDK identity from your authorized installed client (not a developer API key):
HIK_SDK_APP_ID=REPLACE_WITH_INSTALLED_SDK_IDENTITY
# Compose-only settings; choose a free loopback host port.
RGU_API_PORT=21000
RGU_SDK_HOST_DIR=/home/mohan/cam/rgu-fleet-linux/.local/sdk
# WheelsEye server-only telemetry secret. The vendor poll endpoint stores GPS data;
# this endpoint does not provide fuel litres/percentage.
# WHEELSEYE_ACCESS_TOKEN_FILE=/run/secrets/wheelseye-token
# Enable the protected one-workspace poller with the tenant and active admin IDs.
# WHEELSEYE_TENANT_ID=
# WHEELSEYE_ADMIN_USER_ID=
# WHEELSEYE_POLL_INTERVAL_MS=60000
