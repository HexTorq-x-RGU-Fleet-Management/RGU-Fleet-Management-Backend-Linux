# Install inside your existing TLS server block for api.your-domain.example.
# Configure the real certificate separately. Do not replace an unrelated vhost.
client_max_body_size 132m;
location / {
    proxy_pass http://127.0.0.1:21000;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Connection '';
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    gzip off;
}
